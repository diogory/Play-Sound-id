local volume=1
local looping=false

local function updateVolume(percent)
	local p=math.clamp(tonumber(percent) or 0,0,300)
	volume=p/100
	sound.Volume=volume
	volumeBox.Text=tostring(math.floor(p+0.5))
	fill.Size=UDim2.new(volume/3,0,1,0)
	knob.Position=UDim2.new(volume/3,-8,.5,-8)
	volumeLabel.Text="VOLUME  "..math.floor(p+0.5).."%"
end

local function getId()
	local id=idBox.Text:match("%d+")
	if not id then
		return nil
	end
	if #id>15 then
		return nil
	end
	return id
end

local function setStatus(t)
	status.Text="STATUS: "..t
end

local function setVolumeFromBox()
	local cleaned=volumeBox.Text:gsub("[^%d.]","")
	local number=tonumber(cleaned)
	if not number then
		updateVolume(volume*100)
		return
	end
	updateVolume(math.clamp(number,0,300))
end

volumeBox.FocusLost:Connect(function()
	setVolumeFromBox()
end)

play.Activated:Connect(function()
	local id=getId()

	if not id then
		setStatus("INVALID SOUND ID")
		return
	end

	sound:Stop()
	sound.SoundId="rbxassetid://"..id
	sound.TimePosition=0
	sound.Volume=volume
	sound.Looped=looping
	sound:Play()

	setStatus("PLAYING • "..id)
end)

stop.Activated:Connect(function()
	sound:Stop()
	setStatus("STOPPED")
end)

reset.Activated:Connect(function()
	if sound.SoundId~="" then
		sound.TimePosition=0
		setStatus("RESET")
	end
end)

minus.Activated:Connect(function()
	updateVolume(volume*100-10)
end)

plus.Activated:Connect(function()
	updateVolume(volume*100+10)
end)

loopButton.Activated:Connect(function()
	looping=not looping
	sound.Looped=looping
	loopButton.Text=looping and "LOOP: ON" or "LOOP: OFF"
	setStatus(looping and "LOOP ENABLED" or "LOOP DISABLED")
end)

local function makeDraggable(object,onClick)
	local dragging=false
	local moved=false
	local dragStart
	local startPos
	local dragInput

	object.InputBegan:Connect(function(input)
		if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then
			return
		end

		dragging=true
		moved=false
		dragStart=input.Position
		startPos=object.Position

		if input.UserInputType==Enum.UserInputType.Touch then
			dragInput=input
		end
	end)

	object.InputChanged:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
			dragInput=input
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if not dragging or input~=dragInput then
			return
		end

		local delta=input.Position-dragStart

		if math.abs(delta.X)+math.abs(delta.Y)>5 then
			moved=true
		end

		object.Position=UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset+delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset+delta.Y
		)
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then
			return
		end

		if dragging and not moved and onClick then
			onClick()
		end

		dragging=false
		dragInput=nil
	end)
end

